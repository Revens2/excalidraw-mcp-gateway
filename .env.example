# Exemple NON secret — copier vers secrets/excalidraw.env puis renseigner l'empreinte.
# L'empreinte se genere avec : python3 -c "from excalidraw_gateway.oauth import hacher_phrase; print(hacher_phrase('VOTRE_PHRASE'))"
# Ne JAMAIS commiter le fichier reel ni la phrase.
EXCALIDRAW_MCP_PORT=8123
EXCALIDRAW_MCP_ISSUER=https://mymcps.duckdns.org/oauth/excalidraw
EXCALIDRAW_MCP_UPSTREAM=http://127.0.0.1:8122
EXCALIDRAW_MCP_OAUTH_DIR=/srv/excalidraw/data/oauth
EXCALIDRAW_MCP_TOKEN=
EXCALIDRAW_MCP_TOKEN_SCOPES=excalidraw:lecture
EXCALIDRAW_MCP_CONSENT_HASH=
# Bibliotheque distante (page + API /api/*) : jeton Bearer 32+ caracteres, jamais commite.
EXCALIDRAW_BIBLIO_TOKEN=
# Racine physique durable (defaut : /srv/excalidraw/data/bibliotheque).
EXCALIDRAW_BIBLIO_DIR=
# URL de l'editeur pour les deep-links « ouvrir dans Excalidraw »
# (sans le fragment #/<chemin>, ajoute par la passerelle). En production
# privee : l'editeur du vhost NetBird. Absente : repli historique public.
EXCALIDRAW_URL_EDITEUR=http://10.200.114.203:8130/editeur
